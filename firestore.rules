rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------------------

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return getUserData().role;
    }

    function getUserCompanyId() {
      return getUserData().companyId;
    }

    function belongsToCompany(companyId) {
      return isAuthenticated() && getUserCompanyId() == companyId;
    }

    function isSameSite(siteId) {
      return getUserData().siteId == siteId;
    }

    function isRole(role) {
      return isAuthenticated() && getUserRole() == role;
    }

    function isAnyRole(roles) {
      return isAuthenticated() && getUserRole() in roles;
    }

    function isAdmin() {
      return isRole('admin');
    }

    function isSupervisor() {
      return isRole('supervisor') || isRole('maintenance_supervisor');
    }

    function isPlantManager() {
      return isRole('plant_manager');
    }

    function isTechnician() {
      return isRole('technician');
    }

    function isStoreKeeper() {
      return isRole('store_keeper');
    }

    function isHrOfficer() {
      return isRole('hr_officer');
    }

    function canReadContractors() {
      return isAnyRole(['supervisor', 'maintenance_supervisor', 'plant_manager', 'admin']);
    }

    function canManageContractors() {
      return isAnyRole(['supervisor', 'maintenance_supervisor', 'plant_manager', 'admin']);
    }

    // ---------------------------------------------------------------------------
    // Users
    // ---------------------------------------------------------------------------

    match /users/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        isAnyRole(['admin', 'maintenance_supervisor', 'plant_manager'])
      );
      allow write: if isAdmin() || request.auth.uid == userId
        // Supervisors keep the role-mapping doc in sync when editing company
        // users (Users page), but can never grant or touch the admin role.
        || (isAnyRole(['supervisor', 'maintenance_supervisor'])
          && request.resource.data.role != 'admin'
          && (resource == null
            || !('role' in resource.data)
            || resource.data.role != 'admin')
          && (resource == null
            || !('companyId' in resource.data)
            || resource.data.companyId == getUserCompanyId()));
    }

    // ---------------------------------------------------------------------------
    // Work Orders
    // ---------------------------------------------------------------------------

    match /workOrders/{woId} {

      function isAssignedTechnician() {
        return request.auth.uid in resource.data.assignedTechnicianIds;
      }

      function isWOSupervisor() {
        return request.auth.uid == resource.data.supervisorInChargeId;
      }

      // Matches if user's siteId equals the WO's siteId, OR if user has no
      // site restriction (siteId null = company-wide access for their role).
      function woSiteMatches() {
        return getUserData().siteId == null || isSameSite(resource.data.siteId);
      }

      // Admin: full access
      allow read, write: if isAdmin();

      // Supervisor: create WOs for their site. Checked against the incoming
      // document because resource does not exist yet on create.
      allow create: if isSupervisor()
        && (getUserData().siteId == null || isSameSite(request.resource.data.siteId));

      // Supervisor: full read/write for their site (or all sites if unrestricted)
      allow read, write: if isSupervisor() && woSiteMatches();

      // Plant Manager: read for their site (or all sites if unrestricted)
      allow read: if isPlantManager() && woSiteMatches();

      // Plant Manager: manual check-in / start / execution updates on WOs,
      // plus final review sign-off (plant managers sign off completed WOs).
      allow update: if isPlantManager()
        && woSiteMatches()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'statusHistory',
          'checkedInAt', 'checkedInBy', 'checkedInByName',
          'actualStartTime', 'actualEndTime', 'totalDurationMinutes',
          'workDoneDescription', 'rootCause', 'rootCauseDescription',
          'partsUsed', 'technicianWorkLogs', 'contractorHoursLog',
          'postRepairChecklist', 'testRunResult', 'testRunNotes',
          'finalPhotos', 'machineStatusAfterRepair',
          'checklist', 'documents', 'updatedAt',
          'cancelledAt', 'cancelReason', 'timeSegments',
          'supervisorSignOffSignature', 'supervisorSignOffBy',
          'supervisorSignOffAt', 'supervisorSignOffNotes'
        ]);

      // Store Keeper: read-only for their site (or all sites if unrestricted)
      allow read: if isStoreKeeper() && woSiteMatches();

      // Store Keeper: auto-track parts issued against a WO ticket
      allow update: if isStoreKeeper()
        && woSiteMatches()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'partsUsed', 'updatedAt'
        ]);

      // Technician / trainee: read assigned WOs only
      allow read: if (isTechnician() || isRole('trainee')) && woSiteMatches() && isAssignedTechnician();

      // Technician / trainee: update only allowed fields on assigned WOs
      allow update: if (isTechnician() || isRole('trainee'))
        && woSiteMatches()
        && isAssignedTechnician()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'statusHistory',
          'checkedInAt', 'checkedInBy', 'checkedInByName',
          'actualStartTime', 'actualEndTime', 'totalDurationMinutes',
          'workDoneDescription', 'rootCause', 'rootCauseDescription',
          'partsUsed', 'technicianWorkLogs', 'contractorHoursLog',
          'postRepairChecklist', 'testRunResult', 'testRunNotes',
          'finalPhotos', 'machineStatusAfterRepair',
          'checklist', 'documents', 'updatedAt', 'timeSegments'
        ]);

      // Parts requests sub-collection
      match /partsRequests/{requestId} {
        // Technician (own WO), Supervisor, Plant Manager, Store Keeper, Admin can read
        allow read: if isAdmin()
          || isSupervisor()
          || isPlantManager()
          || isStoreKeeper()
          || (isTechnician() && request.auth.uid in get(/databases/$(database)/documents/workOrders/$(woId)).data.assignedTechnicianIds);

        // Technician (own WO), Supervisor, Admin can create
        allow create: if isAdmin()
          || isSupervisor()
          || (isTechnician() && request.auth.uid in get(/databases/$(database)/documents/workOrders/$(woId)).data.assignedTechnicianIds);

        // Store Keeper can update status (approve/reject/issue)
        allow update: if isAdmin()
          || isStoreKeeper()
          || isSupervisor();

        allow delete: if isAdmin();
      }
    }

    // ---------------------------------------------------------------------------
    // WO Counters — Cloud Functions only
    // ---------------------------------------------------------------------------

    match /woCounters/{counterId} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------------------
    // Machine History — Cloud Functions write, authorised roles read
    // ---------------------------------------------------------------------------

    match /machineHistory/{machineId}/entries/{entryId} {
      allow read: if isAuthenticated() && isAnyRole([
        'maintenance_supervisor',
        'supervisor',
        'plant_manager',
        'technician',
        'store_keeper',
        'trainee',
        'admin'
      ]);
      // History entries are appended by the client on WO completion and by
      // Cloud Functions on contractor job close. Immutable once written.
      allow create: if isAuthenticated() && isAnyRole([
        'technician', 'supervisor', 'maintenance_supervisor', 'admin'
      ]);
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------------------
    // Breakdowns (Module 1 — existing)
    // ---------------------------------------------------------------------------

    // breakdown_tickets — used by dashboard widgets and Module 1 list/report pages
    match /breakdown_tickets/{ticketId} {
      allow read: if isAuthenticated() && isAnyRole([
        'floor_operator', 'technician', 'maintenance_supervisor', 'supervisor',
        'plant_manager', 'trainee', 'admin'
      ]);
      allow create: if isAuthenticated() && isAnyRole([
        'floor_operator', 'technician', 'maintenance_supervisor', 'supervisor',
        'plant_manager', 'trainee', 'admin'
      ]);
      allow update: if isAuthenticated() && isAnyRole([
        'technician', 'maintenance_supervisor', 'supervisor', 'plant_manager', 'admin'
      ]);
      allow delete: if isAdmin();
    }

    match /breakdowns/{breakdownId} {
      allow read: if isAuthenticated() && isAnyRole([
        'supervisor', 'maintenance_supervisor', 'plant_manager', 'technician',
        'floor_operator', 'trainee', 'admin'
      ]);
      allow create: if isAuthenticated() && isAnyRole([
        'floor_operator', 'technician', 'supervisor', 'maintenance_supervisor', 'plant_manager', 'trainee', 'admin'
      ]);
      allow update: if isAuthenticated() && isAnyRole([
        'technician', 'supervisor', 'maintenance_supervisor', 'plant_manager', 'admin'
      ]);
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------------------
    // Machines (Module 3 stub — read access for WO creation)
    // ---------------------------------------------------------------------------

    match /machines/{machineId} {
      // floor_operator needs read access: scanning a machine QR opens the
      // breakdown report form, which loads machines to auto-select the one
      // scanned (PM-093).
      allow read: if isAuthenticated() && isAnyRole([
        'floor_operator', 'technician', 'supervisor', 'maintenance_supervisor',
        'plant_manager', 'store_keeper', 'trainee', 'admin'
      ]);
      // Machines updated by Cloud Functions on WO sign-off; supervisors can update too
      allow write: if isAdmin() || isSupervisor() || isPlantManager();
      // Technicians may only stamp service metadata when completing a WO
      allow update: if isTechnician()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastServiceDate', 'lastServiceType', 'nextPmDue', 'updatedAt'
        ]);
    }

    // ---------------------------------------------------------------------------
    // LOTO Permits — created and driven from the WO execution flow
    // ---------------------------------------------------------------------------

    match /permits/{permitId} {
      allow read: if isAuthenticated() && isAnyRole([
        'technician', 'supervisor', 'maintenance_supervisor', 'plant_manager', 'admin'
      ]);
      allow create, update: if isAuthenticated() && isAnyRole([
        'technician', 'supervisor', 'maintenance_supervisor', 'admin'
      ]);
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------------------
    // Condition Monitoring readings — machine profile condition tab
    // ---------------------------------------------------------------------------

    match /conditionReadings/{readingId} {
      allow read: if isAuthenticated() && isAnyRole([
        'technician', 'supervisor', 'maintenance_supervisor', 'plant_manager', 'admin'
      ]);
      allow create: if isAuthenticated() && isAnyRole([
        'technician', 'supervisor', 'maintenance_supervisor', 'plant_manager', 'admin'
      ]);
      // Readings are an immutable log
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------------------
    // Parts / Inventory (Module 6 stub — read for parts search in WO)
    // ---------------------------------------------------------------------------

    match /parts/{partId} {
      allow read: if isAuthenticated() && isAnyRole([
        'technician', 'maintenance_supervisor', 'plant_manager',
        'store_keeper', 'admin'
      ]);
      allow write: if isAdmin() || isStoreKeeper();
    }

    // ---------------------------------------------------------------------------
    // Contractors (Module 7) — external profiles only, no contractor logins
    // ---------------------------------------------------------------------------

    match /contractors/{contractorId} {
      function contractorCompanyMatches() {
        return belongsToCompany(resource.data.companyId);
      }

      function newContractorCompanyMatches() {
        return belongsToCompany(request.resource.data.companyId);
      }

      function financialKeys() {
        return [
          'paymentTerms', 'currency', 'standardLaborRate', 'overtimeRate',
          'emergencyCallOutFee', 'minimumCharge', 'travelFee', 'bankName',
          'bankBranch', 'bankAccountNumber', 'taxRegistrationNumber',
          'preferredInvoiceFormat'
        ];
      }

      allow read: if isAuthenticated() && contractorCompanyMatches()
        && (canReadContractors() || isHrOfficer());
      allow create: if isAuthenticated() && newContractorCompanyMatches()
        && canManageContractors()
        && request.resource.data.status in ['active', 'inactive'];
      allow update: if isAuthenticated() && contractorCompanyMatches()
        && newContractorCompanyMatches()
        && (
          isAdmin()
          || isPlantManager()
          || (
            isSupervisor()
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(financialKeys())
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'status', 'blacklistReason', 'blacklistedAt', 'blacklistedBy'
            ])
          )
        );
      allow delete: if isAdmin();

      // Reads for the two subcollections below are driven by unfiltered
      // `collection(...)` listeners on the client (see useContractorDocuments /
      // useContractorTechnicians) so they also surface legacy docs saved
      // without a companyId. Firestore rejects an entire `list` request outright
      // if the rule depends on a resource.data field the query doesn't filter
      // on (resource.data is per-result-document, not statically verifiable
      // against an unconstrained query) — that silently zeroed out every
      // document/technician list, uploads included, even though the writes
      // themselves succeeded. Anchor the company check on the parent
      // contractor doc (a single get(), independent of the query shape)
      // instead of the subdocument's own companyId field.
      function parentContractorCompanyMatches() {
        return belongsToCompany(get(/databases/$(database)/documents/contractors/$(contractorId)).data.companyId);
      }

      match /documents/{documentId} {
        function newDocCompanyMatches() {
          return belongsToCompany(request.resource.data.companyId)
            && request.resource.data.contractorId == contractorId;
        }

        allow read: if isAuthenticated() && parentContractorCompanyMatches()
          && (canReadContractors() || isHrOfficer());
        allow create, update: if isAuthenticated() && newDocCompanyMatches()
          && canManageContractors();
        allow delete: if false;
      }

      match /technicians/{technicianId} {
        function newTechCompanyMatches() {
          return belongsToCompany(request.resource.data.companyId)
            && request.resource.data.contractorId == contractorId;
        }

        allow read: if isAuthenticated() && parentContractorCompanyMatches() && canReadContractors();
        allow create, update: if isAuthenticated() && newTechCompanyMatches() && canManageContractors();
        allow delete: if false;
      }
    }

    match /contractorJobs/{jobId} {
      function jobCompanyMatches() {
        return belongsToCompany(resource.data.companyId);
      }

      function newJobCompanyMatches() {
        return belongsToCompany(request.resource.data.companyId);
      }

      allow read: if isAuthenticated() && jobCompanyMatches()
        && isAnyRole(['supervisor', 'maintenance_supervisor', 'plant_manager', 'admin']);
      allow create: if false;
      allow update: if isAuthenticated() && jobCompanyMatches()
        && newJobCompanyMatches()
        && (
          isAdmin()
          || isPlantManager()
          || (
            isSupervisor()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'invitationAcknowledgedAt', 'arrivedAt', 'arrivedLoggedBy',
              'workStartedAt', 'workCompletedAt', 'departedAt', 'onSiteDurationMinutes',
              'waitForPartsAt', 'waitForPartsResolvedAt',
              'waitForPermissionAt', 'waitForPermissionResolvedAt',
              'actualWorkDurationMinutes', 'workSteps', 'partsFromContractor',
              'totalPartsCost', 'checklistResults', 'testRunResult', 'testRunNotes',
              'workDoneDescription', 'rootCause',
              'machineStatusAfter', 'photoUrls', 'beforePhotoUrls', 'afterPhotoUrls',
              'documentUrls', 'signedOffBy', 'signedOffByName', 'signedOffAt',
              'signOffNotes', 'signOffSignature', 'isDisputed', 'disputeNotes',
              'rating', 'followUpRequired', 'followUpReason', 'followUpBreakdownId',
              'contractorInvoiceAmount', 'contractorInvoiceRef', 'contractorInvoiceDate',
              'contractorInvoiceUrl', 'invoiceStatus', 'updatedAt'
            ])
          )
          || (
            isStoreKeeper()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'partsFromFactory', 'totalPartsFactoryCost', 'totalPartsCost', 'updatedAt'
            ])
          )
        );
      allow delete: if false;
    }

    match /contractorInvitations/{invitationId} {
      allow read: if isAuthenticated() && belongsToCompany(resource.data.companyId)
        && isAnyRole(['supervisor', 'maintenance_supervisor', 'plant_manager', 'admin']);
      allow create, update, delete: if false;
    }

    // ---------------------------------------------------------------------------
    // Users (FCM tokens, roles, site assignments)
    // ---------------------------------------------------------------------------

    match /siteConfig/{siteId} {
      allow read: if isAuthenticated() && isSameSite(siteId);
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------------------
    // Triage Flows (Module 4)
    // ---------------------------------------------------------------------------

    match /triageFlows/{flowId} {
      allow read: if isAuthenticated() && belongsToCompany(resource.data.companyId)
                   && isAnyRole(['supervisor', 'plant_manager', 'admin']);
      allow write: if isAuthenticated() && isAnyRole(['supervisor', 'admin'])
                   && request.resource.data.companyId == getUserCompanyId();
    }

    // ---------------------------------------------------------------------------
    // Triage Sessions (Module 4)
    // ---------------------------------------------------------------------------

    match /triageSessions/{sessionId} {
      allow read: if isAuthenticated() && belongsToCompany(resource.data.companyId)
                   && isAnyRole(['supervisor', 'plant_manager', 'admin', 'technician']);
      allow write: if isAuthenticated() && isAnyRole(['supervisor', 'admin'])
                   && request.resource.data.companyId == getUserCompanyId();
    }

    // ---------------------------------------------------------------------------
    // Triage Templates (Module 4 — read-only for customers)
    // ---------------------------------------------------------------------------

    match /triageTemplates/{templateId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isAdmin();
    }

    // ---------------------------------------------------------------------------
    // Companies & company users — required for signup / login / profile load
    // ---------------------------------------------------------------------------

    // /companies/{companyId}
    // - Creating the company on signup: allowed when the authenticated user
    //   is being recorded as the admin of the new company.
    // - Reading / updating: members of that company.
    match /companies/{companyId} {
      allow read: if isAuthenticated()
        && (
          // Owner / member lookup via /users/{uid} mapping
          (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && getUserData().companyId == companyId)
          // Or the company document itself records this user as admin (used
          // during signup before /users/{uid} mapping is readable in rules).
          || (resource != null && resource.data.adminUserId == request.auth.uid)
        );

      allow create: if isAuthenticated()
        && request.resource.data.adminUserId == request.auth.uid
        && request.resource.data.id == companyId;

      allow update: if isAuthenticated()
        && (
          (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && getUserData().companyId == companyId
            && getUserData().role == 'admin')
          || resource.data.adminUserId == request.auth.uid
        );

      allow delete: if false;
    }

    // /companies/{companyId}/users/{userId} — per-company user profile
    match /companies/{companyId}/users/{userId} {
      allow read: if isAuthenticated()
        && (
          request.auth.uid == userId
          || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
              && getUserData().companyId == companyId
              && getUserData().role in ['admin', 'maintenance_supervisor', 'plant_manager', 'hr_officer', 'supervisor'])
        );

      // Self-create during signup; admins create anyone; supervisors/plant
      // managers create non-admin members (Users page "Add member")
      allow create: if isAuthenticated()
        && (
          request.auth.uid == userId
          || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
              && getUserData().companyId == companyId
              && (getUserData().role == 'admin'
                || (getUserData().role in ['supervisor', 'maintenance_supervisor', 'plant_manager']
                  && request.resource.data.role != 'admin')))
        );

      // Self-update (e.g. lastLoginAt, profile fields), admin-update, or
      // supervisor/plant_manager/hr_officer-update of non-admin members
      // (cannot grant admin) — the latter also covers job title / position
      // changes made from a completed Evaluation (PM-124).
      allow update: if isAuthenticated()
        && (
          request.auth.uid == userId
          || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
              && getUserData().companyId == companyId
              && (getUserData().role == 'admin'
                || (getUserData().role in ['supervisor', 'maintenance_supervisor', 'plant_manager', 'hr_officer']
                  && resource.data.role != 'admin'
                  && request.resource.data.role != 'admin')))
        );

      allow delete: if isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && getUserData().companyId == companyId
        && getUserData().role == 'admin';
    }

    // /companies/{companyId}/pendingInvites/{token} — saved during onboarding,
    // consumed by a Cloud Function or admin later.
    match /companies/{companyId}/pendingInvites/{token} {
      allow read, write: if isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && getUserData().companyId == companyId
        && getUserData().role in ['admin', 'maintenance_supervisor', 'plant_manager', 'hr_officer'];
    }

    // /companies/{companyId}/invitations/{invitationId} — Users page invite
    // flow. The invitation id is only discoverable via the secret token doc
    // (/inviteTokens/{token}), so a public `get` acts as a capability URL for
    // the invite-acceptance page; listing stays restricted to managers.
    match /companies/{companyId}/invitations/{invitationId} {
      function canManageInvites() {
        return exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && getUserData().companyId == companyId
          && getUserData().role in ['admin', 'supervisor', 'maintenance_supervisor', 'plant_manager', 'hr_officer'];
      }

      allow get: if true;
      allow list: if isAuthenticated() && canManageInvites();
      // Only admins may invite new admins
      allow create: if isAuthenticated() && canManageInvites()
        && (getUserData().role == 'admin' || request.resource.data.role != 'admin');
      // Managers revoke/resend; the invited user marks their own acceptance
      allow update: if isAuthenticated()
        && (
          canManageInvites()
          || (request.resource.data.status == 'accepted'
            && request.resource.data.acceptedUserId == request.auth.uid)
        );
      allow delete: if isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && getUserData().companyId == companyId
        && getUserData().role == 'admin';
    }

    // /inviteTokens/{token} — maps a secret invite token to its invitation.
    // The token itself is the credential, so single-doc reads are public
    // (needed on the pre-auth invite landing page); listing is forbidden.
    match /inviteTokens/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && getUserData().companyId == request.resource.data.companyId
        && getUserData().role in ['admin', 'supervisor', 'maintenance_supervisor', 'plant_manager', 'hr_officer'];
      allow update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------------------
    // Inventory Module (Module 6 — root-level flat collections)
    // Data is stored at root level with a companyId field for multi-tenancy.
    // ---------------------------------------------------------------------------

    match /inventoryParts/{partId} {
      allow read: if isAuthenticated() && getUserData().companyId == resource.data.companyId;
      allow create: if isAuthenticated() && getUserData().companyId == request.resource.data.companyId
        && getUserData().role in ['store_keeper', 'supervisor', 'maintenance_supervisor', 'plant_manager', 'admin'];
      allow update: if isAuthenticated() && getUserData().companyId == resource.data.companyId
        && getUserData().role in ['store_keeper', 'supervisor', 'maintenance_supervisor', 'plant_manager', 'admin'];
      allow delete: if isAuthenticated() && getUserData().companyId == resource.data.companyId
        && getUserData().role in ['plant_manager', 'admin'];
    }

    match /stockMovements/{movementId} {
      allow read: if isAuthenticated() && getUserData().companyId == resource.data.companyId;
      allow create: if isAuthenticated() && getUserData().companyId == request.resource.data.companyId
        && getUserData().role in ['store_keeper', 'supervisor', 'maintenance_supervisor', 'plant_manager', 'admin'];
      allow update: if false;
      allow delete: if false;
    }

    match /partsRequests/{requestId} {
      allow read: if isAuthenticated() && getUserData().companyId == resource.data.companyId;
      allow create: if isAuthenticated() && getUserData().companyId == request.resource.data.companyId;
      allow update: if isAuthenticated() && getUserData().companyId == resource.data.companyId
        && (getUserData().role in ['store_keeper', 'supervisor', 'maintenance_supervisor', 'plant_manager', 'admin']
          || (getUserData().role == 'technician' && resource.data.requestedBy == request.auth.uid
              && request.resource.data.status == 'cancelled'));
      allow delete: if false;
    }

    match /purchaseOrders/{poId} {
      allow read: if isAuthenticated() && getUserData().companyId == resource.data.companyId;
      allow create: if isAuthenticated() && getUserData().companyId == request.resource.data.companyId
        && getUserData().role in ['store_keeper', 'supervisor', 'maintenance_supervisor', 'plant_manager', 'admin'];
      allow update: if isAuthenticated() && getUserData().companyId == resource.data.companyId
        && getUserData().role in ['store_keeper', 'supervisor', 'maintenance_supervisor', 'plant_manager', 'admin'];
      allow delete: if isAuthenticated() && getUserData().companyId == resource.data.companyId
        && getUserData().role in ['plant_manager', 'admin'];
    }

    match /suppliers/{supplierId} {
      allow read: if isAuthenticated() && getUserData().companyId == resource.data.companyId;
      allow create: if isAuthenticated() && getUserData().companyId == request.resource.data.companyId
        && getUserData().role in ['store_keeper', 'supervisor', 'maintenance_supervisor', 'plant_manager', 'admin'];
      allow update: if isAuthenticated() && getUserData().companyId == resource.data.companyId
        && getUserData().role in ['store_keeper', 'supervisor', 'maintenance_supervisor', 'plant_manager', 'admin'];
      allow delete: if isAuthenticated() && getUserData().companyId == resource.data.companyId
        && getUserData().role in ['plant_manager', 'admin'];
    }

    match /inventoryImportSessions/{sessionId} {
      allow read: if isAuthenticated() && getUserData().companyId == resource.data.companyId
        && (getUserData().role in ['supervisor', 'maintenance_supervisor', 'plant_manager', 'admin']
          || resource.data.importedBy == request.auth.uid);
      allow create: if isAuthenticated() && getUserData().companyId == request.resource.data.companyId
        && getUserData().role in ['store_keeper', 'supervisor', 'maintenance_supervisor', 'plant_manager', 'admin'];
      allow update: if isAuthenticated() && getUserData().companyId == resource.data.companyId
        && (getUserData().role in ['supervisor', 'maintenance_supervisor', 'plant_manager', 'admin']
          || resource.data.importedBy == request.auth.uid);
      allow delete: if false;
    }

    match /inventorySettings/{settingsId} {
      allow read: if isAuthenticated() && getUserData().companyId == resource.data.companyId;
      allow write: if isAuthenticated() && getUserData().companyId == resource.data.companyId
        && getUserData().role in ['supervisor', 'maintenance_supervisor', 'plant_manager', 'admin'];
    }

    // ---------------------------------------------------------------------------
    // Inventory Module (Module 6 — company-scoped legacy paths, kept for compat)
    // ---------------------------------------------------------------------------

    match /companies/{companyId}/inventoryParts/{partId} {
      // Everyone authenticated in the company can read
      allow read: if isAuthenticated() && getUserData().companyId == companyId;
      // Create: store_keeper, supervisor, plant_manager, admin
      allow create: if isAuthenticated() && getUserData().companyId == companyId
        && getUserData().role in ['store_keeper', 'maintenance_supervisor', 'plant_manager', 'admin'];
      // Update: store_keeper, supervisor, plant_manager, admin
      allow update: if isAuthenticated() && getUserData().companyId == companyId
        && getUserData().role in ['store_keeper', 'maintenance_supervisor', 'plant_manager', 'admin'];
      // Delete: plant_manager and admin only (never technician or store_keeper)
      allow delete: if isAuthenticated() && getUserData().companyId == companyId
        && getUserData().role in ['plant_manager', 'admin'];
    }

    // stockMovements — IMMUTABLE audit log — never allow delete or update
    match /companies/{companyId}/stockMovements/{movementId} {
      allow read: if isAuthenticated() && getUserData().companyId == companyId;
      allow create: if isAuthenticated() && getUserData().companyId == companyId
        && getUserData().role in ['store_keeper', 'maintenance_supervisor', 'plant_manager', 'admin'];
      allow update: if false;  // Immutable
      allow delete: if false;  // NEVER delete stock movements
    }

    // partsRequests — top-level inventory parts requests (distinct from WO sub-collection)
    match /companies/{companyId}/partsRequests/{requestId} {
      allow read: if isAuthenticated() && getUserData().companyId == companyId;
      // Create: any authenticated user in the company
      allow create: if isAuthenticated() && getUserData().companyId == companyId;
      // Update: store_keeper, supervisor, plant_manager, admin can review/approve
      // Technician can only cancel their own requests
      allow update: if isAuthenticated() && getUserData().companyId == companyId
        && (getUserData().role in ['store_keeper', 'maintenance_supervisor', 'plant_manager', 'admin']
          || (getUserData().role == 'technician' && resource.data.requestedBy == request.auth.uid
              && request.resource.data.status == 'cancelled'));
      allow delete: if false;
    }

    // purchaseOrders
    match /companies/{companyId}/purchaseOrders/{poId} {
      allow read: if isAuthenticated() && getUserData().companyId == companyId;
      allow create: if isAuthenticated() && getUserData().companyId == companyId
        && getUserData().role in ['store_keeper', 'maintenance_supervisor', 'plant_manager', 'admin'];
      allow update: if isAuthenticated() && getUserData().companyId == companyId
        && getUserData().role in ['store_keeper', 'maintenance_supervisor', 'plant_manager', 'admin'];
      allow delete: if isAuthenticated() && getUserData().companyId == companyId
        && getUserData().role in ['plant_manager', 'admin'];
    }

    // inventoryImportSessions
    match /companies/{companyId}/inventoryImportSessions/{sessionId} {
      allow read: if isAuthenticated() && getUserData().companyId == companyId
        && (getUserData().role in ['maintenance_supervisor', 'plant_manager', 'admin']
          || resource.data.importedBy == request.auth.uid);
      allow create: if isAuthenticated() && getUserData().companyId == companyId
        && getUserData().role in ['store_keeper', 'maintenance_supervisor', 'plant_manager', 'admin'];
      allow update: if isAuthenticated() && getUserData().companyId == companyId
        && (getUserData().role in ['maintenance_supervisor', 'plant_manager', 'admin']
          || resource.data.importedBy == request.auth.uid);
      allow delete: if false;
    }

    // inventorySettings — one doc per company
    match /companies/{companyId}/inventorySettings/{settingsId} {
      allow read: if isAuthenticated() && getUserData().companyId == companyId;
      allow write: if isAuthenticated() && getUserData().companyId == companyId
        && getUserData().role in ['maintenance_supervisor', 'plant_manager', 'admin'];
    }

    // ---------------------------------------------------------------------------
    // Training Module 5 — Training System
    // ---------------------------------------------------------------------------

    // trainingModules — authored content, company-scoped
    match /companies/{companyId}/trainingModules/{moduleId} {
      // Read: all staff roles + trainee + floor_operator (trainees need to load module content)
      allow read: if isAuthenticated() && getUserData().companyId == companyId
        && getUserData().role in [
          'trainee', 'floor_operator', 'supervisor', 'plant_manager',
          'hr_officer', 'admin'
        ];
      // Create / Update: authoring is a plant_manager/admin action (PM-118) —
      // keep in sync with the top-level /trainingModules rules.
      allow create: if isAuthenticated() && getUserData().companyId == companyId
        && getUserData().role in ['plant_manager', 'admin'];
      allow update: if isAuthenticated() && getUserData().companyId == companyId
        && getUserData().role in ['plant_manager', 'admin'];
      allow delete: if isAuthenticated() && getUserData().companyId == companyId
        && getUserData().role in ['plant_manager', 'admin'];
    }

    // trainingAssignments — individual learner enrolments, company-scoped
    match /companies/{companyId}/trainingAssignments/{assignmentId} {
      // Read: own assignment (trainee/floor_operator) OR management roles
      allow read: if isAuthenticated() && getUserData().companyId == companyId
        && (
          resource.data.traineeId == request.auth.uid
          || getUserData().role in ['supervisor', 'plant_manager', 'hr_officer', 'admin']
        );
      // Create: managers and HR can assign training — keep in sync with the
      // top-level /trainingAssignments rules (plant_manager must be able to
      // assign members to trainings).
      allow create: if isAuthenticated() && getUserData().companyId == companyId
        && getUserData().role in ['supervisor', 'maintenance_supervisor', 'plant_manager', 'hr_officer', 'admin'];
      // Update: trainee can only update their own progress fields; supervisors/admins can update anything
      allow update: if isAuthenticated() && getUserData().companyId == companyId
        && (
          (
            resource.data.traineeId == request.auth.uid
            && getUserData().role in ['trainee', 'floor_operator']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'lessonProgress', 'quizAttempts', 'lastActivityAt',
              'overallProgress', 'lessonsCompleted', 'startedAt',
              'bestScore', 'latestScore', 'quizPassed', 'quizPassedAt',
              'attemptsUsed', 'status'
            ])
          )
          || getUserData().role in ['supervisor', 'maintenance_supervisor', 'plant_manager', 'hr_officer', 'admin']
        );
      // Delete: admin only
      allow delete: if isAuthenticated() && getUserData().companyId == companyId
        && getUserData().role == 'admin';
    }

    // trainingCertificates — immutable audit record, company-scoped
    match /companies/{companyId}/trainingCertificates/{certificateId} {
      // Read: own certificate OR management roles
      allow read: if isAuthenticated() && getUserData().companyId == companyId
        && (
          resource.data.traineeId == request.auth.uid
          || getUserData().role in ['supervisor', 'plant_manager', 'hr_officer', 'admin']
        );
      // Create: via Cloud Function only — direct client writes disabled
      allow create: if false;
      // Update: admin or plant_manager (e.g. for revocation)
      allow update: if isAuthenticated() && getUserData().companyId == companyId
        && getUserData().role in ['plant_manager', 'admin'];
      // Delete: never
      allow delete: if false;
    }

    // trainingContentLibrary — shared media assets, company-scoped
    match /companies/{companyId}/trainingContentLibrary/{itemId} {
      // Read: supervisor, plant_manager, admin
      allow read: if isAuthenticated() && getUserData().companyId == companyId
        && getUserData().role in ['supervisor', 'plant_manager', 'admin'];
      // Write (create/update/delete): supervisor and admin
      allow write: if isAuthenticated() && getUserData().companyId == companyId
        && getUserData().role in ['supervisor', 'admin'];
    // pm_schedules — Preventive Maintenance Schedules
    }

    // shift_config — shift setup, manageable by admin and shift-running roles.
    // Every company member can read: members must see the shift plans they
    // are scheduled on (My Shift page).
    match /shift_config/{configId} {
      allow read: if isAuthenticated() && belongsToCompany(resource.data.companyId);
      allow create: if isAuthenticated() && belongsToCompany(request.resource.data.companyId)
        && getUserData().role in ['supervisor', 'maintenance_supervisor', 'plant_manager', 'admin', 'hr_officer'];
      allow update: if isAuthenticated() && belongsToCompany(resource.data.companyId)
        && getUserData().role in ['supervisor', 'maintenance_supervisor', 'plant_manager', 'admin', 'hr_officer'];
      allow delete: if isAuthenticated() && belongsToCompany(resource.data.companyId)
        && isAdmin();
    }

    // shift_handovers — supervisor accountability transfer records
    match /shift_handovers/{handoverId} {
      allow read: if isAuthenticated() && belongsToCompany(resource.data.companyId)
        && getUserData().role in ['supervisor', 'maintenance_supervisor', 'plant_manager', 'admin', 'hr_officer'];
      allow create: if isAuthenticated() && belongsToCompany(request.resource.data.companyId)
        && getUserData().role in ['supervisor', 'maintenance_supervisor', 'admin'];
      allow update: if isAuthenticated() && belongsToCompany(resource.data.companyId)
        && getUserData().role in ['supervisor', 'maintenance_supervisor', 'admin'];
      allow delete: if false;
    }

    // shift_sessions — per-member worked-shift records (start/end, hours, OT)
    match /shift_sessions/{sessionId} {
      // Members read their own sessions; managers read all company sessions.
      allow read: if isAuthenticated() && belongsToCompany(resource.data.companyId)
        && (resource.data.userId == request.auth.uid
          || getUserData().role in ['supervisor', 'maintenance_supervisor', 'plant_manager', 'admin', 'hr_officer']);
      // Members create/update only their own session records.
      allow create: if isAuthenticated() && belongsToCompany(request.resource.data.companyId)
        && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && belongsToCompany(resource.data.companyId)
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if false;
    }

    // shift_stats — analytics feed written by Cloud Functions
    match /shift_stats/{statId} {
      allow read: if isAuthenticated() && belongsToCompany(resource.data.companyId)
        && getUserData().role in ['supervisor', 'maintenance_supervisor', 'plant_manager', 'admin'];
      allow write: if false;
    }

    match /pm_schedules/{scheduleId} {
      allow read: if isAuthenticated() && belongsToCompany(resource.data.companyId)
        && getUserData().role in ['supervisor', 'plant_manager', 'admin', 'technician'];
      allow create: if isAuthenticated()
        && getUserData().role in ['supervisor', 'admin'];
      // Plant managers can archive/delete PM schedules (but not create them).
      allow update: if isAuthenticated() && belongsToCompany(resource.data.companyId)
        && getUserData().role in ['supervisor', 'plant_manager', 'admin'];
      allow delete: if isAuthenticated() && belongsToCompany(resource.data.companyId)
        && getUserData().role in ['supervisor', 'plant_manager', 'admin'];
    }

    // pm_history — PM execution history
    match /pm_history/{historyId} {
      allow read: if isAuthenticated() && belongsToCompany(resource.data.companyId)
        && getUserData().role in ['supervisor', 'plant_manager', 'admin', 'technician'];
      allow create: if isAuthenticated(); // System-generated
      allow update: if isAuthenticated() && belongsToCompany(resource.data.companyId)
        && getUserData().role in ['supervisor', 'maintenance_supervisor', 'plant_manager', 'admin'];
      // Technicians stamp completion tracking when they finish a PM work order.
      allow update: if isAuthenticated() && belongsToCompany(resource.data.companyId)
        && getUserData().role == 'technician'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'completedDate', 'duration', 'daysOverdue',
          'technicianIds', 'technicianNames', 'woNumber'
        ]);
      allow delete: if false;
    }

    // Audit module — configurable TPM/5S/OEE/Contractor audit templates.
    // Path is scoped by plantId (the user's companyId).
    match /audit_templates/{plantId}/templates/{templateId} {
      allow read: if isAuthenticated() && belongsToCompany(plantId)
        && getUserData().role in ['supervisor', 'plant_manager', 'admin', 'technician', 'hr_officer'];
      allow write: if isAuthenticated() && belongsToCompany(plantId)
        && getUserData().role in ['supervisor', 'plant_manager', 'admin', 'technician'];
    }

    // Audit sessions — submitted audit records (with findings, attachments,
    // AI suggestions, and generated PDF report links). Store Keeper does not
    // have access to the Audit module.
    match /audit_sessions/{plantId}/sessions/{sessionId} {
      allow read: if isAuthenticated() && belongsToCompany(plantId)
        && getUserData().role in ['supervisor', 'plant_manager', 'admin', 'technician', 'hr_officer'];
      allow create, update: if isAuthenticated() && belongsToCompany(plantId)
        && getUserData().role in ['supervisor', 'plant_manager', 'admin', 'technician', 'hr_officer'];
      allow delete: if isAuthenticated() && belongsToCompany(plantId)
        && getUserData().role in ['supervisor', 'admin'];
    }

    // ---------------------------------------------------------------------------
    // OEE Module — plantId is the companyId
    // ---------------------------------------------------------------------------

    match /oee_records/{plantId}/records/{recordId} {
      allow read: if isAuthenticated() && belongsToCompany(plantId)
        && getUserData().role in ['supervisor', 'maintenance_supervisor', 'plant_manager', 'admin', 'technician'];
      allow create, update: if isAuthenticated() && belongsToCompany(plantId)
        && getUserData().role in ['supervisor', 'maintenance_supervisor', 'plant_manager', 'admin'];
      allow delete: if isAuthenticated() && belongsToCompany(plantId)
        && getUserData().role in ['plant_manager', 'admin'];
    }

    match /oee_trends/{plantId}/machines/{machineId}/monthly/{month} {
      allow read: if isAuthenticated() && belongsToCompany(plantId)
        && getUserData().role in ['supervisor', 'maintenance_supervisor', 'plant_manager', 'admin', 'technician'];
      allow write: if isAuthenticated() && belongsToCompany(plantId)
        && getUserData().role in ['supervisor', 'maintenance_supervisor', 'plant_manager', 'admin'];
    }

    match /oee_targets/{plantId}/machines/{machineId} {
      allow read: if isAuthenticated() && belongsToCompany(plantId)
        && getUserData().role in ['supervisor', 'maintenance_supervisor', 'plant_manager', 'admin', 'technician'];
      allow write: if isAuthenticated() && belongsToCompany(plantId)
        && getUserData().role in ['supervisor', 'maintenance_supervisor', 'plant_manager', 'admin'];
    }

    // rca — Root Cause Analysis records
    match /rca/{rcaId} {
      allow read: if isAuthenticated() && isSameSite(resource.data.siteId)
        && isAnyRole(['supervisor', 'maintenance_supervisor', 'plant_manager', 'admin', 'technician']);
      allow create: if isAuthenticated() && isSameSite(request.resource.data.siteId)
        && isAnyRole(['supervisor', 'maintenance_supervisor', 'plant_manager', 'admin', 'technician']);
      allow update: if isAuthenticated() && isSameSite(resource.data.siteId)
        && isAnyRole(['supervisor', 'maintenance_supervisor', 'plant_manager', 'admin', 'technician']);
      allow delete: if isAdmin();
    }

    // maintenanceBacklog — deferred maintenance items with risk scores
    match /maintenanceBacklog/{itemId} {
      allow read: if isAuthenticated() && isSameSite(resource.data.siteId)
        && isAnyRole(['supervisor', 'maintenance_supervisor', 'plant_manager', 'admin', 'technician']);
      allow create: if isAuthenticated() && isSameSite(request.resource.data.siteId)
        && isAnyRole(['supervisor', 'maintenance_supervisor', 'plant_manager', 'admin']);
      allow update: if isAuthenticated() && isSameSite(resource.data.siteId)
        && isAnyRole(['supervisor', 'maintenance_supervisor', 'plant_manager', 'admin']);
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------------------
    // Analytics aggregations — written by backend jobs, read by dashboard/analytics
    // ---------------------------------------------------------------------------

    match /analytics_monthly/{docId} {
      allow read: if isAuthenticated() && belongsToCompany(resource.data.companyId)
        && isAnyRole(['supervisor', 'maintenance_supervisor', 'plant_manager', 'admin']);
      allow write: if false;
    }

    match /analytics_daily/{docId} {
      allow read: if isAuthenticated() && belongsToCompany(resource.data.companyId)
        && isAnyRole(['supervisor', 'maintenance_supervisor', 'plant_manager', 'admin']);
      allow write: if false;
    }

    match /machine_health/{docId} {
      allow read: if isAuthenticated() && belongsToCompany(resource.data.companyId)
        && isAnyRole(['supervisor', 'maintenance_supervisor', 'plant_manager', 'admin', 'technician']);
      allow write: if false;
    }

    // ---------------------------------------------------------------------------
    // Training (Module: training) — modules, assignments, certificates,
    // content library and completion records
    // ---------------------------------------------------------------------------

    match /trainingModules/{moduleId} {
      // Authoring (create/update/delete) is a Plant Manager / Admin action —
      // supervisors and other roles may only read and assign modules.
      allow read: if isAuthenticated() && belongsToCompany(resource.data.companyId);
      allow create: if isAuthenticated() && belongsToCompany(request.resource.data.companyId)
        && isAnyRole(['plant_manager', 'admin']);
      allow update: if isAuthenticated() && belongsToCompany(resource.data.companyId)
        && isAnyRole(['plant_manager', 'admin']);
      allow delete: if isAuthenticated() && belongsToCompany(resource.data.companyId)
        && isAnyRole(['plant_manager', 'admin']);
    }

    match /trainingAssignments/{assignmentId} {
      // Trainees read their own assignments; managers/HR read all in company
      allow read: if isAuthenticated() && belongsToCompany(resource.data.companyId)
        && (resource.data.traineeId == request.auth.uid
          || isAnyRole(['supervisor', 'maintenance_supervisor', 'plant_manager', 'hr_officer', 'admin']));
      allow create: if isAuthenticated() && belongsToCompany(request.resource.data.companyId)
        && isAnyRole(['supervisor', 'maintenance_supervisor', 'plant_manager', 'hr_officer', 'admin']);
      // Trainees update their own progress/quiz attempts; managers update any
      allow update: if isAuthenticated() && belongsToCompany(resource.data.companyId)
        && (resource.data.traineeId == request.auth.uid
          || isAnyRole(['supervisor', 'maintenance_supervisor', 'plant_manager', 'hr_officer', 'admin']));
      allow delete: if isAuthenticated() && belongsToCompany(resource.data.companyId)
        && isAnyRole(['supervisor', 'maintenance_supervisor', 'admin']);
    }

    match /trainingCertificates/{certId} {
      allow read: if isAuthenticated() && belongsToCompany(resource.data.companyId)
        && (resource.data.traineeId == request.auth.uid
          || isAnyRole(['supervisor', 'maintenance_supervisor', 'plant_manager', 'hr_officer', 'admin']));
      // Issued client-side on quiz pass (trainee) or by managers/HR
      allow create: if isAuthenticated() && belongsToCompany(request.resource.data.companyId)
        && (request.resource.data.traineeId == request.auth.uid
          || isAnyRole(['supervisor', 'maintenance_supervisor', 'plant_manager', 'hr_officer', 'admin']));
      // Revocation and edits are a management action
      allow update: if isAuthenticated() && belongsToCompany(resource.data.companyId)
        && isAnyRole(['supervisor', 'maintenance_supervisor', 'plant_manager', 'hr_officer', 'admin']);
      allow delete: if isAdmin();
    }

    match /trainingContentLibrary/{contentId} {
      allow read: if isAuthenticated() && belongsToCompany(resource.data.companyId);
      allow create: if isAuthenticated() && belongsToCompany(request.resource.data.companyId)
        && isAnyRole(['supervisor', 'maintenance_supervisor', 'plant_manager', 'admin']);
      allow update, delete: if isAuthenticated() && belongsToCompany(resource.data.companyId)
        && isAnyRole(['supervisor', 'maintenance_supervisor', 'plant_manager', 'admin']);
    }

    match /training_records/{recordId} {
      allow read: if isAuthenticated() && belongsToCompany(resource.data.companyId)
        && isAnyRole(['supervisor', 'maintenance_supervisor', 'plant_manager', 'hr_officer', 'admin']);
      allow create, update: if isAuthenticated() && belongsToCompany(request.resource.data.companyId)
        && isAnyRole(['supervisor', 'maintenance_supervisor', 'plant_manager', 'hr_officer', 'admin']);
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------------------
    // Trainee Programme (Module: trainee role) — structured 6-month/1-year
    // training programme, weekly summaries and completion certificates.
    // ---------------------------------------------------------------------------

    match /traineeProgrammes/{programmeId} {
      // Read: own programme (trainee) OR management roles
      allow read: if isAuthenticated() && belongsToCompany(resource.data.companyId)
        && (resource.data.traineeId == request.auth.uid
          || isAnyRole(['supervisor', 'maintenance_supervisor', 'plant_manager', 'hr_officer', 'admin']));
      // Create/update/delete: management sets up and manages the programme
      allow create: if isAuthenticated() && belongsToCompany(request.resource.data.companyId)
        && isAnyRole(['supervisor', 'maintenance_supervisor', 'plant_manager', 'hr_officer', 'admin']);
      allow update: if isAuthenticated() && belongsToCompany(resource.data.companyId)
        && isAnyRole(['supervisor', 'maintenance_supervisor', 'plant_manager', 'hr_officer', 'admin']);
      allow delete: if isAdmin();
    }

    match /weekendSummaries/{summaryId} {
      // Read: own summary (trainee) OR management roles
      allow read: if isAuthenticated() && belongsToCompany(resource.data.companyId)
        && (resource.data.traineeId == request.auth.uid
          || isAnyRole(['supervisor', 'maintenance_supervisor', 'plant_manager', 'hr_officer', 'admin']));
      // Create: trainee submits their own summary (admin can submit on their behalf)
      allow create: if isAuthenticated() && belongsToCompany(request.resource.data.companyId)
        && request.resource.data.traineeId == request.auth.uid
        && isAnyRole(['trainee', 'admin']);
      // Update: trainee cannot edit after submission; management reviews (sets reviewStatus/comments)
      allow update: if isAuthenticated() && belongsToCompany(resource.data.companyId)
        && isAnyRole(['supervisor', 'maintenance_supervisor', 'plant_manager', 'hr_officer', 'admin']);
      allow delete: if isAdmin();
    }

    match /traineeProgrammeCertCounters/{companyId} {
      allow read, write: if isAuthenticated() && belongsToCompany(companyId)
        && isAnyRole(['supervisor', 'maintenance_supervisor', 'plant_manager', 'admin']);
    }

    match /traineeProgrammeCertificates/{certId} {
      allow read: if isAuthenticated() && belongsToCompany(resource.data.companyId)
        && (resource.data.traineeId == request.auth.uid
          || isAnyRole(['supervisor', 'maintenance_supervisor', 'plant_manager', 'hr_officer', 'admin']));
      // Issued client-side by the in-charge (supervisor/admin/plant manager) on programme completion
      allow create: if isAuthenticated() && belongsToCompany(request.resource.data.companyId)
        && isAnyRole(['supervisor', 'maintenance_supervisor', 'plant_manager', 'admin']);
      allow update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------------------
    // Triage knowledge base (Modules: triage, triage builder) — categories,
    // content, contacts, assessments and results. Any company member can read
    // and can create (first-load seeding runs for whichever user opens the
    // page first); editing/deleting is restricted to builder roles.
    // ---------------------------------------------------------------------------

    match /triage_categories/{docId} {
      allow read: if isAuthenticated() && belongsToCompany(resource.data.companyId);
      allow create: if isAuthenticated() && belongsToCompany(request.resource.data.companyId);
      allow update, delete: if isAuthenticated() && belongsToCompany(resource.data.companyId)
        && isAnyRole(['supervisor', 'maintenance_supervisor', 'plant_manager', 'admin']);
    }

    match /triage_content_items/{docId} {
      allow read: if isAuthenticated() && belongsToCompany(resource.data.companyId);
      allow create: if isAuthenticated() && belongsToCompany(request.resource.data.companyId);
      allow update, delete: if isAuthenticated() && belongsToCompany(resource.data.companyId)
        && isAnyRole(['supervisor', 'maintenance_supervisor', 'plant_manager', 'admin']);
    }

    match /triage_contacts/{docId} {
      allow read: if isAuthenticated() && belongsToCompany(resource.data.companyId);
      allow create: if isAuthenticated() && belongsToCompany(request.resource.data.companyId);
      allow update, delete: if isAuthenticated() && belongsToCompany(resource.data.companyId)
        && isAnyRole(['supervisor', 'maintenance_supervisor', 'plant_manager', 'admin']);
    }

    match /triage_assessments/{docId} {
      allow read: if isAuthenticated() && belongsToCompany(resource.data.companyId);
      allow create: if isAuthenticated() && belongsToCompany(request.resource.data.companyId);
      allow update, delete: if isAuthenticated() && belongsToCompany(resource.data.companyId)
        && isAnyRole(['supervisor', 'maintenance_supervisor', 'plant_manager', 'admin']);
    }

    match /triage_assessment_results/{docId} {
      allow read: if isAuthenticated() && belongsToCompany(resource.data.companyId);
      allow create: if isAuthenticated() && belongsToCompany(request.resource.data.companyId);
      allow update, delete: if isAuthenticated() && belongsToCompany(resource.data.companyId)
        && isAnyRole(['supervisor', 'maintenance_supervisor', 'plant_manager', 'admin']);
    }

    match /triage_sessions/{docId} {
      allow read: if isAuthenticated() && belongsToCompany(resource.data.companyId)
        && isAnyRole(['supervisor', 'maintenance_supervisor', 'plant_manager', 'hr_officer', 'admin']);
      allow create, update: if isAuthenticated() && belongsToCompany(request.resource.data.companyId);
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------------------
    // Reports (Module: reports) — generated report history + audit trail
    // ---------------------------------------------------------------------------

    match /report_history/{reportId} {
      allow read: if isAuthenticated() && belongsToCompany(resource.data.companyId)
        && isAnyRole(['supervisor', 'maintenance_supervisor', 'plant_manager', 'store_keeper', 'hr_officer', 'admin']);
      allow create: if isAuthenticated() && belongsToCompany(request.resource.data.companyId)
        && isAnyRole(['supervisor', 'maintenance_supervisor', 'plant_manager', 'store_keeper', 'hr_officer', 'admin']);
      allow delete: if isAuthenticated() && belongsToCompany(resource.data.companyId)
        && isAnyRole(['supervisor', 'maintenance_supervisor', 'plant_manager', 'admin']);
    }

    // report_schedules — recurring report export schedules (read/created/
    // managed by report-capable roles; the scheduled Cloud Function runs
    // under the Admin SDK and bypasses these rules).
    match /report_schedules/{scheduleId} {
      allow read, update, delete: if isAuthenticated() && belongsToCompany(resource.data.companyId)
        && isAnyRole(['supervisor', 'maintenance_supervisor', 'plant_manager', 'admin']);
      allow create: if isAuthenticated() && belongsToCompany(request.resource.data.companyId)
        && isAnyRole(['supervisor', 'maintenance_supervisor', 'plant_manager', 'admin']);
    }

    match /audit_logs/{logId} {
      // Append-only log written whenever a report is generated/exported
      allow read: if isAuthenticated() && belongsToCompany(resource.data.companyId)
        && isAnyRole(['plant_manager', 'admin', 'hr_officer']);
      allow create: if isAuthenticated() && belongsToCompany(request.resource.data.companyId);
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------------------
    // Inventory extras — PO e-mail notification queue (consumed by backend)
    // ---------------------------------------------------------------------------

    match /po_notifications/{docId} {
      allow read: if isAuthenticated() && belongsToCompany(resource.data.companyId)
        && isAnyRole(['store_keeper', 'supervisor', 'maintenance_supervisor', 'plant_manager', 'admin']);
      allow create: if isAuthenticated() && belongsToCompany(request.resource.data.companyId)
        && isAnyRole(['store_keeper', 'supervisor', 'maintenance_supervisor', 'plant_manager', 'admin']);
      allow update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------------------
    // Dashboard support — in-app notifications, technician live status,
    // departments lookup
    // ---------------------------------------------------------------------------

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && belongsToCompany(resource.data.companyId);
      allow create: if isAuthenticated() && belongsToCompany(request.resource.data.companyId);
      allow update: if isAuthenticated() && belongsToCompany(resource.data.companyId);
      allow delete: if isAuthenticated() && belongsToCompany(resource.data.companyId)
        && isAnyRole(['supervisor', 'maintenance_supervisor', 'plant_manager', 'admin']);
    }

    match /technician_status/{docId} {
      allow read: if isAuthenticated() && belongsToCompany(resource.data.companyId);
      allow create, update: if isAuthenticated() && belongsToCompany(request.resource.data.companyId);
      allow delete: if isAdmin();
    }

    match /departments/{deptId} {
      allow read: if isAuthenticated() && belongsToCompany(resource.data.companyId);
      allow create: if isAuthenticated() && belongsToCompany(request.resource.data.companyId)
        && isAnyRole(['supervisor', 'maintenance_supervisor', 'plant_manager', 'hr_officer', 'admin']);
      allow update, delete: if isAuthenticated() && belongsToCompany(resource.data.companyId)
        && isAnyRole(['supervisor', 'maintenance_supervisor', 'plant_manager', 'hr_officer', 'admin']);
    }

    // ---------------------------------------------------------------------------
    // Evaluations
    // ---------------------------------------------------------------------------

    match /evaluations/{evalId} {
      allow read: if isAuthenticated() && belongsToCompany(resource.data.companyId)
        && isAnyRole(['supervisor', 'maintenance_supervisor', 'plant_manager', 'hr_officer', 'admin']);
      allow create: if isAuthenticated() && belongsToCompany(request.resource.data.companyId)
        && isAnyRole(['supervisor', 'maintenance_supervisor', 'plant_manager', 'hr_officer', 'admin']);
      allow update: if isAuthenticated() && belongsToCompany(resource.data.companyId)
        && isAnyRole(['supervisor', 'maintenance_supervisor', 'plant_manager', 'hr_officer', 'admin']);
      allow delete: if isAdmin();
    }

    match /evaluation_sessions/{sessionId} {
      allow read: if isAuthenticated() && belongsToCompany(resource.data.companyId)
        && isAnyRole(['supervisor', 'maintenance_supervisor', 'plant_manager', 'hr_officer', 'admin']);
      allow create, update: if isAuthenticated() && belongsToCompany(request.resource.data.companyId)
        && isAnyRole(['supervisor', 'maintenance_supervisor', 'plant_manager', 'hr_officer', 'admin']);
      allow delete: if isAdmin();
    }

    // Custom evaluation form templates (PM-122) — anyone who can conduct
    // evaluations may read/use templates; only Plant Manager/Admin author them.
    match /evaluation_templates/{templateId} {
      allow read: if isAuthenticated() && belongsToCompany(resource.data.companyId)
        && isAnyRole(['supervisor', 'maintenance_supervisor', 'plant_manager', 'hr_officer', 'admin']);
      allow create: if isAuthenticated() && belongsToCompany(request.resource.data.companyId)
        && isAnyRole(['plant_manager', 'admin']);
      allow update, delete: if isAuthenticated() && belongsToCompany(resource.data.companyId)
        && isAnyRole(['plant_manager', 'admin']);
    }

    // ---------------------------------------------------------------------------
    // Kaizen — plant-scoped card board (path segment is the company id)
    // ---------------------------------------------------------------------------

    match /kaizen_cards/{plantId}/cards/{cardId} {
      allow read: if isAuthenticated() && belongsToCompany(plantId);
      allow create, update: if isAuthenticated() && belongsToCompany(plantId)
        && getUserData().role in ['technician', 'store_keeper', 'supervisor', 'maintenance_supervisor', 'plant_manager', 'hr_officer', 'admin'];
      allow delete: if isAuthenticated() && belongsToCompany(plantId)
        && getUserData().role in ['supervisor', 'maintenance_supervisor', 'plant_manager', 'admin'];
    }

    // ---------------------------------------------------------------------------
    // 5S — zones, audits and corrective actions (plant-scoped)
    // ---------------------------------------------------------------------------

    match /fives_zones/{plantId}/zones/{zoneId} {
      allow read: if isAuthenticated() && belongsToCompany(plantId);
      allow write: if isAuthenticated() && belongsToCompany(plantId)
        && getUserData().role in ['supervisor', 'maintenance_supervisor', 'plant_manager', 'admin'];
    }

    match /fives_audits/{plantId}/audits/{auditId} {
      allow read: if isAuthenticated() && belongsToCompany(plantId);
      allow write: if isAuthenticated() && belongsToCompany(plantId)
        && getUserData().role in ['technician', 'supervisor', 'maintenance_supervisor', 'plant_manager', 'admin'];
    }

    match /fives_corrective_actions/{plantId}/actions/{actionId} {
      allow read: if isAuthenticated() && belongsToCompany(plantId);
      allow write: if isAuthenticated() && belongsToCompany(plantId)
        && getUserData().role in ['technician', 'supervisor', 'maintenance_supervisor', 'plant_manager', 'admin'];
    }

    // ---------------------------------------------------------------------------
    // TPM — pillars, monthly scores, maturity and autonomous-maintenance tasks
    // (plant-scoped; path segment is the company id)
    // ---------------------------------------------------------------------------

    match /tpm_pillars/{plantId}/pillars/{pillarId} {
      allow read: if isAuthenticated() && belongsToCompany(plantId);
      allow write: if isAuthenticated() && belongsToCompany(plantId)
        && getUserData().role in ['supervisor', 'maintenance_supervisor', 'plant_manager', 'admin'];
    }

    match /tpm_scores/{plantId}/monthly/{monthKey} {
      allow read: if isAuthenticated() && belongsToCompany(plantId);
      allow write: if isAuthenticated() && belongsToCompany(plantId)
        && getUserData().role in ['supervisor', 'maintenance_supervisor', 'plant_manager', 'admin'];
    }

    match /tpm_maturity/{plantId}/machines/{machineId} {
      allow read: if isAuthenticated() && belongsToCompany(plantId);
      allow write: if isAuthenticated() && belongsToCompany(plantId)
        && getUserData().role in ['supervisor', 'maintenance_supervisor', 'plant_manager', 'admin'];
    }

    match /am_tasks/{plantId}/tasks/{taskId} {
      allow read: if isAuthenticated() && belongsToCompany(plantId);
      allow write: if isAuthenticated() && belongsToCompany(plantId)
        && getUserData().role in ['technician', 'supervisor', 'maintenance_supervisor', 'plant_manager', 'admin'];
    }
  }
}

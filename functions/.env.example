# Stripe billing catalog config for Cloud Functions.
# These are plan/cycle -> Stripe Price ID mappings — not secrets. Create the
# Products/Prices in the Stripe Dashboard first, then copy their price IDs
# here. Copy this file to functions/.env (gitignored) to use locally, or set
# the same keys as Cloud Functions runtime environment variables in prod.
#
# The actual API keys (STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET) are NOT set
# here — they are Firebase secrets, set with:
#   firebase functions:secrets:set STRIPE_SECRET_KEY
#   firebase functions:secrets:set STRIPE_WEBHOOK_SECRET
# (STRIPE_WEBHOOK_SECRET is the "signing secret" for the webhook endpoint,
# created in the Stripe Dashboard once the stripeWebhook function is
# deployed and its URL is registered as a webhook endpoint there.)

STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_WORKSHOP_MONTHLY=
STRIPE_PRICE_WORKSHOP_YEARLY=
STRIPE_PRICE_FACTORY_MONTHLY=
STRIPE_PRICE_FACTORY_YEARLY=

# Stripe publishable key (pk_live_… / pk_test_…, same mode as
# STRIPE_SECRET_KEY) for the in-page card window on the Billing page. Public
# by design — safe to commit; handed to the browser by getBillingOverview.
STRIPE_PUBLISHABLE_KEY=
